{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skill-router/route-decision.schema.json",
  "title": "Skill Route Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "decision", "selected_skill", "confidence",
    "matched_tags", "candidates", "reason_codes", "versions"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["invoke", "none", "error"]},
    "selected_skill": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "winner_margin": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "matched_tags": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "score"],
        "properties": {
          "tag": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "score", "rank", "matched_tags", "reason_codes"],
        "properties": {
          "skill_id": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "rank": {"type": "integer", "minimum": 1, "maximum": 12},
          "matched_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "taxonomy", "index_schema", "ranking_policy"],
      "properties": {
        "protocol": {"type": "string"},
        "taxonomy": {"type": "string"},
        "index_schema": {"type": "string"},
        "ranking_policy": {"type": "string"},
        "embedding_model": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "invoke"}}},
      "then": {"properties": {"selected_skill": {"type": "string"}}, "required": ["winner_margin"]}
    },
    {
      "if": {"properties": {"decision": {"enum": ["none", "error"]}}},
      "then": {"properties": {"selected_skill": {"type": "null"}}}
    }
  ]
}
