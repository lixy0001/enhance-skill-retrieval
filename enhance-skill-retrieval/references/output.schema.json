{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill retrieval enhancer result",
  "type": "object",
  "oneOf": [
    {"required": ["decision", "selected_skill_id", "reason_codes"]},
    {"required": ["agreement", "enhanced_skill_id", "baseline_skill_id", "root_causes"]}
  ],
  "properties": {
    "decision": {"enum": ["candidates", "invoke", "none", "bypass", "error"]},
    "selected_skill_id": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "winner_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "winner_margin": {"type": "number", "minimum": 0, "maximum": 1},
    "matched_tags": {"type": "array", "items": {"type": "string"}},
    "feedback_tags": {"type": "array", "items": {"type": "string"}},
    "candidate_skill_ids": {"type": "array", "items": {"type": "string"}},
    "candidate_choice_scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "candidate_fit_scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "reranker_model": {"type": "string"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "root_causes": {"type": "array", "items": {"type": "string"}},
    "agreement": {"type": "boolean"},
    "enhanced_skill_id": {"type": ["string", "null"]},
    "baseline_skill_id": {"type": ["string", "null"]},
    "inferred_intent_tags": {"type": "array", "items": {"type": "string"}},
    "registry_version": {"type": "string"},
    "enabled_skill_ids_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
