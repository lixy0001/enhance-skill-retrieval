{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill retrieval enhancer request",
  "type": "object",
  "oneOf": [
    {
      "required": ["query", "registry_version", "enabled_skill_ids"],
      "propertyNames": {"enum": ["query", "registry_version", "enabled_skill_ids", "candidate_skills"]}
    },
    {
      "required": ["operation"],
      "properties": {
        "operation": {"enum": ["initialize_tags", "rebuild_tags", "sync_tags", "set_tags", "reclassify_tags", "inspect_tags", "comparison_status", "benchmark"]}
      }
    },
    {
      "required": ["operation", "comparison_id", "query", "enhanced_result", "baseline_result"],
      "properties": {
        "operation": {"const": "compare_routing"}
      }
    }
  ],
  "properties": {
    "operation": {"enum": ["initialize_tags", "rebuild_tags", "sync_tags", "set_tags", "reclassify_tags", "inspect_tags", "compare_routing", "comparison_status", "benchmark"]},
    "registry_version": {"type": "string"},
    "activation_threshold": {"type": "integer", "minimum": 1},
    "query": {"type": "string"},
    "enabled_skill_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "candidate_skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "comparison_id": {"type": "string"},
    "skill_id": {"type": "string"},
    "feedback_tags": {"type": "array", "items": {"type": "string"}},
    "enhanced_result": {"$ref": "#/$defs/route_result"},
    "baseline_result": {"$ref": "#/$defs/route_result"},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "route_result": {
      "type": "object",
      "required": ["decision", "selected_skill_id", "registry_version", "enabled_skill_ids_digest"],
      "properties": {
        "decision": {"enum": ["invoke", "none"]},
        "selected_skill_id": {"type": ["string", "null"]},
        "matched_tags": {"type": "array", "items": {"type": "string"}},
        "feedback_tags": {"type": "array", "items": {"type": "string"}},
        "candidate_skill_ids": {"type": "array", "items": {"type": "string"}},
        "registry_version": {"type": "string"},
        "enabled_skill_ids_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "skill": {
      "type": "object",
      "required": ["skill_id", "name", "description"],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "metadata_version": {"type": "string"}
      }
    }
  }
}
