{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill retrieval enhancer request",
  "type": "object",
  "required": ["operation"],
  "properties": {
    "operation": {"enum": ["initialize_tags", "sync_tags", "set_tags", "reclassify_tags", "inspect_tags", "route"]},
    "registry_version": {"type": "string"},
    "activation_threshold": {"type": "integer", "minimum": 1},
    "query": {"type": "string"},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["skill_id", "name", "description"],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "metadata_version": {"type": "string"}
      }
    }
  }
}
