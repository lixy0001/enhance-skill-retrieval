#!/usr/bin/env python3
"""Stable command-line interface for inspecting and editing Skill tags."""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any, Dict, Mapping

from index_store import load_vector_cache, save_vector_cache, update_vector_cache
from retrieval_core import (
    load_feedback_state,
    load_resources,
    load_state,
    mutate_tags,
    record_pending_feedback,
    register_feedback_request,
    reclassify_record,
    read_json,
    save_feedback_state,
    save_state,
    state_path,
)


STATE_ENV = "ENHANCE_SKILL_STATE_DIR"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="enhance-skill",
        description="Inspect and edit tags used by enhance-skill-retrieval.",
    )
    parser.add_argument(
        "--state-dir",
        help=f"Harness state directory; defaults to ${STATE_ENV}",
    )
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    sub = parser.add_subparsers(dest="command", required=True)

    list_tags = sub.add_parser("list-tags", help="List controlled tags and assignment counts")
    list_tags.add_argument("--assigned-only", action="store_true")

    sub.add_parser("list-skills", help="List Skill IDs and their effective tags")

    show = sub.add_parser("show-tags", help="Show all tag sources for one Skill")
    show.add_argument("skill_id")

    by_tag = sub.add_parser("skills-by-tag", help="List Skills assigned to a tag")
    by_tag.add_argument("tag")

    for command, help_text in (
        ("add-tags", "Add manual tags to a Skill"),
        ("remove-tags", "Remove manual tags from a Skill"),
        ("lock-tags", "Add and lock manual tags on a Skill"),
        ("unlock-tags", "Unlock tags while retaining them as manual tags"),
    ):
        item = sub.add_parser(command, help=help_text)
        item.add_argument("skill_id")
        item.add_argument("tags", nargs="+")

    reclassify = sub.add_parser("reclassify-tags", help="Regenerate automatic tags from Skill metadata")
    reclassify.add_argument("skill_id")
    reclassify.add_argument("--input", default="-", help="JSON Skill object; defaults to stdin")

    request_feedback = sub.add_parser(
        "request-feedback", help="Sample whether to ask for feedback after a completed task"
    )
    request_feedback.add_argument("--interaction-id", required=True)
    request_feedback.add_argument("--route-result", required=True, help="JSON route result file")
    request_feedback.add_argument("--query", required=True, help="Completed task query; vectorized but not stored")
    request_feedback.add_argument("--sample-rate", type=float)
    request_feedback.add_argument("--sampling-salt", default="")

    record = sub.add_parser("record-feedback", help="Record an accurate or inaccurate selection")
    record.add_argument("--interaction-id", required=True)
    record.add_argument("--rating", choices=("accurate", "inaccurate"), required=True)
    expected = record.add_mutually_exclusive_group()
    expected.add_argument("--expected-skill-id")
    expected.add_argument("--expected-none", action="store_true")
    record.add_argument("--expected-tags", nargs="*", default=[])
    record.add_argument("--sampling-salt", default="")

    feedback_status = sub.add_parser("feedback-status", help="Show aggregate feedback counts")
    feedback_status.add_argument("skill_id", nargs="?")

    sub.add_parser("status", help="Show tag-library status and activation threshold")
    return parser


def resolve_state_dir(value: str | None) -> str | None:
    return value or os.environ.get(STATE_ENV)


def require_state_dir(value: str | None) -> str:
    resolved = resolve_state_dir(value)
    if not resolved:
        raise ValueError(f"set {STATE_ENV} or pass --state-dir")
    return resolved


def count_assignments(state: Mapping[str, Any]) -> Dict[str, int]:
    counts: Dict[str, int] = {}
    for record in state.get("skills", {}).values():
        for tag in record.get("effective_tags", []):
            counts[tag] = counts.get(tag, 0) + 1
    return counts


def list_tag_rows(taxonomy: Mapping[str, Any], state: Mapping[str, Any]) -> list[Dict[str, Any]]:
    counts = count_assignments(state)
    controlled = {item["id"] for item in taxonomy.get("tags", [])}
    rows = [
        {
            "tag": item["id"],
            "name": item.get("name_zh", ""),
            "controlled": True,
            "assigned_skill_count": counts.get(item["id"], 0),
        }
        for item in taxonomy.get("tags", [])
    ]
    rows.extend(
        {
            "tag": tag,
            "name": "",
            "controlled": False,
            "assigned_skill_count": count,
        }
        for tag, count in sorted(counts.items())
        if tag not in controlled
    )
    return rows


def emit(data: Mapping[str, Any], as_json: bool) -> None:
    if as_json:
        json.dump(data, sys.stdout, ensure_ascii=False, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return

    kind = data.get("kind")
    if kind == "tags":
        print("TAG\tNAME\tTYPE\tSKILLS")
        for row in data["tags"]:
            print(
                f"{row['tag']}\t{row['name']}\t"
                f"{'controlled' if row['controlled'] else 'auxiliary'}\t"
                f"{row['assigned_skill_count']}"
            )
    elif kind == "skills":
        print("SKILL\tEFFECTIVE TAGS")
        for skill_id, tags in data["skills"].items():
            print(f"{skill_id}\t{', '.join(tags) or '-'}")
    elif kind == "skill-tags":
        print(f"Skill: {data['skill_id']}")
        for field in ("locked_tags", "manual_tags", "native_tags", "agent_tags", "effective_tags"):
            print(f"{field}: {', '.join(data['record'].get(field, [])) or '-'}")
        reason = data["record"].get("classification_reason", "")
        if reason:
            print(f"classification_reason: {reason}")
    elif kind == "skills-by-tag":
        print(f"Tag: {data['tag']}")
        for skill_id in data["skills"]:
            print(skill_id)
    elif kind == "status":
        print(f"initialized: {'yes' if data['initialized'] else 'no'}")
        print(f"state_file: {data['state_file']}")
        print(f"skill_count: {data['skill_count']}")
        print(f"activation_threshold: {data['activation_threshold']}")
        print(f"tag_retrieval: {data['tag_retrieval']}")
    elif kind == "feedback-request":
        print(f"sampled: {'yes' if data['sampled'] else 'no'}")
        if data.get("question"):
            print(data["question"])
    elif kind == "feedback-status":
        print(f"total_responses: {data['total_responses']}")
        print(f"root_causes: {json.dumps(data.get('root_causes', {}), ensure_ascii=False)}")
        for skill_id, counts in data["skills"].items():
            print(f"{skill_id}\taccurate={counts.get('positive', 0)}\tinaccurate={counts.get('negative', 0)}")
    elif kind == "feedback-recorded":
        print(f"Skill: {data['skill_id']}")
        print(f"rating: {data['rating']}")
        print(f"accurate: {data['skill_counts'].get('positive', 0)}")
        print(f"inaccurate: {data['skill_counts'].get('negative', 0)}")
        print(f"root_causes: {', '.join(data.get('root_causes', []))}")
    else:
        print(f"Skill: {data['skill_id']}")
        print(f"status: {data['status']}")
        print(f"effective_tags: {', '.join(data['record'].get('effective_tags', [])) or '-'}")


def main() -> int:
    args = build_parser().parse_args()
    taxonomy, policy, provider = load_resources()
    state_dir = resolve_state_dir(args.state_dir)

    if args.command == "list-tags":
        state = load_state(state_dir, required=False) if state_dir else {"skills": {}}
        rows = list_tag_rows(taxonomy, state)
        if args.assigned_only:
            rows = [row for row in rows if row["assigned_skill_count"]]
        output: Dict[str, Any] = {"kind": "tags", "tags": rows}
    elif args.command == "request-feedback":
        state_dir = require_state_dir(args.state_dir)
        state = load_state(state_dir)
        route_result = read_json(args.route_result)
        if route_result.get("decision") != "invoke":
            raise ValueError("feedback requires an invoke route result")
        selected_skill_id = route_result.get("selected_skill_id")
        if selected_skill_id not in state.get("skills", {}):
            raise KeyError(f"unknown skill_id: {selected_skill_id}")
        effective_tags = set(state["skills"][selected_skill_id].get("effective_tags", []))
        feedback_tags = route_result.get("feedback_tags", [])
        invalid_tags = sorted(set(feedback_tags) - effective_tags)
        if invalid_tags:
            raise ValueError(
                "feedback tags are not assigned to the selected Skill: "
                + ", ".join(invalid_tags)
            )
        sample_rate = (
            args.sample_rate
            if args.sample_rate is not None
            else float(policy.get("feedback_sample_rate", 0.10))
        )
        feedback = load_feedback_state(state_dir)
        sampled = register_feedback_request(
            feedback,
            args.interaction_id,
            route_result,
            provider.embed(args.query),
            sample_rate,
            args.sampling_salt,
            int(policy.get("feedback_pending_limit", 1000)),
        )
        if sampled:
            save_feedback_state(state_dir, feedback)
        output = {
            "kind": "feedback-request",
            "sampled": sampled,
            "skill_id": selected_skill_id,
            "feedback_tags": feedback_tags,
            "sample_rate": sample_rate,
            "question": (
                f"本次使用的 Skill“{selected_skill_id}”是否准确？请选择：准确 / 不准确"
                if sampled
                else None
            ),
            "negative_followup": (
                "若不准确，请提供正确 Skill（或无需 Skill）以及用户需求对应的标签。"
                if sampled
                else None
            ),
        }
    elif args.command == "status":
        if state_dir:
            path = state_path(state_dir)
            initialized = path.exists()
            state = load_state(state_dir, required=False)
            state_file = str(path)
        else:
            initialized = False
            state = {"skills": {}}
            state_file = f"unset (set {STATE_ENV})"
        skill_count = len(state.get("skills", {}))
        threshold = int(policy["activation_threshold"])
        output = {
            "kind": "status",
            "initialized": initialized,
            "state_file": state_file,
            "skill_count": skill_count,
            "activation_threshold": threshold,
            "tag_retrieval": "enabled" if skill_count > threshold else "bypass",
        }
    else:
        state_dir = require_state_dir(args.state_dir)
        state = load_state(state_dir)
        if args.command == "list-skills":
            output = {
                "kind": "skills",
                "skills": {
                    skill_id: record.get("effective_tags", [])
                    for skill_id, record in sorted(state.get("skills", {}).items())
                },
            }
        elif args.command == "show-tags":
            record = state.get("skills", {}).get(args.skill_id)
            if record is None:
                raise KeyError(f"unknown skill_id: {args.skill_id}")
            output = {"kind": "skill-tags", "skill_id": args.skill_id, "record": record}
        elif args.command == "skills-by-tag":
            matches = sorted(
                skill_id
                for skill_id, record in state.get("skills", {}).items()
                if args.tag in record.get("effective_tags", [])
            )
            output = {"kind": "skills-by-tag", "tag": args.tag, "skills": matches}
        elif args.command == "reclassify-tags":
            skill = read_json(args.input)
            if skill.get("skill_id") != args.skill_id:
                raise ValueError("input requires a matching Skill object")
            cache = load_vector_cache(state_dir, state, taxonomy, provider, required=True)
            record = reclassify_record(state, skill, taxonomy, provider)
            save_state(state_dir, state)
            save_vector_cache(
                state_dir,
                update_vector_cache(
                    cache,
                    {"event": "skill_updated", "skill": skill},
                    state,
                    taxonomy,
                    provider,
                ),
            )
            output = {"kind": "updated", "status": "reclassified", "skill_id": args.skill_id, "record": record}
        elif args.command == "record-feedback":
            if args.rating == "accurate" and (
                args.expected_skill_id or args.expected_none or args.expected_tags
            ):
                raise ValueError("accurate feedback must not include expected corrections")
            if args.rating == "inaccurate" and not (
                args.expected_none or (args.expected_skill_id and args.expected_tags)
            ):
                raise ValueError(
                    "inaccurate feedback requires expected_skill_id with expected_tags, or expected_none"
                )
            if args.expected_none and args.expected_tags:
                raise ValueError("expected_none must not include expected_tags")
            controlled_tags = {item["id"] for item in taxonomy.get("tags", [])}
            invalid_expected = sorted(set(args.expected_tags) - controlled_tags)
            if invalid_expected:
                raise ValueError(
                    "expected tags must be controlled tags: " + ", ".join(invalid_expected)
                )
            if args.expected_skill_id and args.expected_skill_id not in state.get("skills", {}):
                raise KeyError(f"unknown skill_id: {args.expected_skill_id}")
            feedback = load_feedback_state(state_dir)
            recorded = record_pending_feedback(
                feedback,
                args.interaction_id,
                args.rating == "accurate",
                state,
                args.expected_skill_id,
                args.expected_tags,
                args.expected_none,
                args.sampling_salt,
            )
            save_feedback_state(state_dir, feedback)
            output = {"kind": "feedback-recorded", **recorded}
        elif args.command == "feedback-status":
            feedback = load_feedback_state(state_dir)
            skills = feedback.get("skills", {})
            if args.skill_id:
                skills = {args.skill_id: skills.get(args.skill_id, {"positive": 0, "negative": 0})}
            output = {
                "kind": "feedback-status",
                "total_responses": feedback.get("total_responses", 0),
                "skills": skills,
                "root_causes": feedback.get("root_causes", {}),
                "rerank_skills": (
                    {args.skill_id: feedback.get("rerank_skills", {}).get(args.skill_id, {})}
                    if args.skill_id
                    else feedback.get("rerank_skills", {})
                ),
                "annotation_suggestions": (
                    {args.skill_id: feedback.get("annotation_suggestions", {}).get(args.skill_id, {})}
                    if args.skill_id
                    else feedback.get("annotation_suggestions", {})
                ),
                "query_tag_correction_pairs": sum(
                    len(expected) for expected in feedback.get("query_tag_corrections", {}).values()
                ),
            }
        else:
            action = {
                "add-tags": "add",
                "remove-tags": "remove",
                "lock-tags": "lock",
                "unlock-tags": "unlock",
            }[args.command]
            record = mutate_tags(state, args.skill_id, action, args.tags)
            save_state(state_dir, state)
            output = {"kind": "updated", "status": args.command, "skill_id": args.skill_id, "record": record}

    emit(output, args.json)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (FileNotFoundError, KeyError, ValueError) as error:
        print(f"enhance-skill: {error}", file=sys.stderr)
        raise SystemExit(2)
