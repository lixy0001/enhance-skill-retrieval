{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skill-router/index.schema.json",
  "title": "Skill Library Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_version", "generated_at", "roots", "skills", "tag_postings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "root_fingerprint": {"type": "string"},
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "canonical_path"],
        "properties": {
          "source": {"enum": ["personal", "shared", "plugin"]},
          "canonical_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/skill"}
    },
    "tag_postings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "uniqueItems": true
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id", "name", "description", "canonical_path", "source", "content_hash",
        "enabled", "primary_tags", "secondary_tags", "facets", "positive_examples", "negative_examples"
      ],
      "properties": {
        "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "canonical_path": {"type": "string", "minLength": 1},
        "source": {"enum": ["personal", "shared", "plugin"]},
        "plugin_id": {"type": ["string", "null"]},
        "plugin_version": {"type": ["string", "null"]},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "modified_at": {"type": ["string", "null"], "format": "date-time"},
        "enabled": {"type": "boolean"},
        "shadowed_by": {"type": ["string", "null"]},
        "primary_tags": {
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"}
        },
        "secondary_tags": {
          "type": "array", "maxItems": 5, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "facets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {"$ref": "#/$defs/stringSet"},
            "artifact": {"$ref": "#/$defs/stringSet"},
            "action": {"$ref": "#/$defs/stringSet"},
            "temporal_scope": {"$ref": "#/$defs/stringSet"},
            "access_mode": {"$ref": "#/$defs/stringSet"}
          }
        },
        "positive_examples": {"$ref": "#/$defs/stringSet"},
        "negative_examples": {"$ref": "#/$defs/stringSet"},
        "embedding_ref": {"type": ["string", "null"]},
        "classification_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "needs_review": {"type": "boolean"}
      }
    },
    "stringSet": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
